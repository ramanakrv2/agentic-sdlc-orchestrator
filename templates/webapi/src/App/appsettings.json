{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "InstanceId": "",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/app.db;Cache=Shared;Default Timeout=5",
    "ResetOnModelChange": true
  },
  "Cache": {
    "Enabled": true,
    "Provider": "Memory",
    "RedisConfiguration": "localhost:6379",
    "DefaultTtlSeconds": 300,
    "CircuitBreaker": { "FailureRatio": 0.5, "MinimumThroughput": 5, "SamplingSeconds": 10, "BreakSeconds": 15 }
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 200,
    "WindowSeconds": 10
  },
  "Requests": {
    "TimeoutMs": 5000
  },
  "Chaos": {
    "CacheFaultRate": 0.0,
    "DbLatencyMs": 0
  }
}
