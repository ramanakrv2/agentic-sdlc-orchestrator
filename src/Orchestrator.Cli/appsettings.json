{
  "Llm": {
    "Mode": "Auto",
    "Endpoint": "http://localhost:11434/v1",
    "ApiKey": "ollama",
    "PrimaryModel": "qwen2.5-coder:3b",
    "FallbackModel": "qwen2.5-coder:1.5b",
    "TimeoutSeconds": 600,
    "MaxRetries": 2,
    "MaxConcurrentCalls": 1,
    "CacheDirectory": "llm-cache",
    "RecordLiveResponses": true,
    "CircuitBreaker": { "FailureRatio": 0.5, "MinimumThroughput": 4, "SamplingSeconds": 120, "BreakSeconds": 30 },
    "Chaos": { "FaultRate": 0.0, "LatencyRate": 0.0, "LatencyMs": 2000 }
  },
  "Engine": {
    "MaxDegreeOfParallelism": 4,
    "MaxRevisionsPerNode": 3
  },
  "Storage": {
    "Provider": "Sqlite",
    "Path": ".orchestrator/orchestrator.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  }
}
